{
  "name": "@archstone/provider-rest",
  "version": "0.32.0",
  "private": false,
  "type": "module",
  "description": "REST provider for Archstone — maps capability input to an HTTP request and maps the response back to a typed, validated result.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "archstone",
    "cdl",
    "rest",
    "http",
    "provider",
    "api-integration"
  ],
  "license": "Apache-2.0",
  "homepage": "https://archstone.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NousVigil/archstone.git",
    "directory": "providers/rest"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@archstone/compiler": "workspace:*",
    "@archstone/emitter-support": "workspace:*"
  },
  "devDependencies": {
    "@archstone/schema": "workspace:*",
    "tsup": "^8.5.1"
  }
}
