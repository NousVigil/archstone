{
  "name": "@archstone/runtime",
  "version": "0.31.0",
  "private": false,
  "type": "module",
  "description": "Archstone runtime — a capability registry over compiled IR, and the MCP emitter that serves it as agent-callable tools over stdio or HTTP.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "archstone",
    "cdl",
    "mcp-server",
    "stdio",
    "streamable-http",
    "runtime"
  ],
  "license": "Apache-2.0",
  "homepage": "https://archstone.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NousVigil/archstone.git",
    "directory": "packages/runtime"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./connector": {
      "types": "./dist/connector.d.ts",
      "default": "./dist/connector.js"
    },
    "./connector-rest": {
      "types": "./dist/connector-rest.d.ts",
      "default": "./dist/connector-rest.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@archstone/compiler": "workspace:*",
    "@archstone/emitter-support": "workspace:*",
    "@archstone/provider-rest": "workspace:*",
    "@archstone/provider-sql": "workspace:*",
    "@archstone/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
