{
  "name": "@archstone/emitter-support",
  "version": "0.29.0",
  "private": false,
  "type": "module",
  "description": "Shared substrate for Archstone emitters: IR indexing, semantic-type to JSON Schema lowering, and response mapping. No MCP SDK, no filesystem.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "archstone",
    "cdl",
    "json-schema",
    "emitter",
    "code-generation"
  ],
  "license": "Apache-2.0",
  "homepage": "https://archstone.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NousVigil/archstone.git",
    "directory": "packages/emitter-support"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@archstone/compiler": "workspace:*"
  },
  "devDependencies": {
    "@archstone/schema": "workspace:*",
    "ajv": "^8.17.1",
    "tsup": "^8.5.1"
  }
}
