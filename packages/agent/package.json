{
  "name": "@archstone/agent",
  "version": "0.31.0",
  "private": false,
  "type": "module",
  "description": "Embed Archstone capabilities directly in your own agent loop: typed tool definitions for Anthropic, OpenAI, Gemini and plain JSON Schema, plus fail-closed execution over a compiled IR — no MCP server process required.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "archstone",
    "cdl",
    "agent-sdk",
    "tool-use",
    "function-calling",
    "anthropic",
    "openai",
    "gemini"
  ],
  "license": "Apache-2.0",
  "homepage": "https://archstone.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NousVigil/archstone.git",
    "directory": "packages/agent"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@archstone/compiler": "workspace:*",
    "@archstone/emitter-support": "workspace:*",
    "@archstone/provider-rest": "workspace:*",
    "@archstone/runtime": "workspace:*"
  },
  "devDependencies": {
    "@archstone/schema": "workspace:*",
    "tsup": "^8.5.1"
  }
}
