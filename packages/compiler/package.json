{
  "name": "@archstone/compiler",
  "version": "0.30.0",
  "private": false,
  "type": "module",
  "description": "The Archstone compiler — validates a capability model and lowers it to a target-agnostic intermediate representation that every emitter consumes.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "archstone",
    "cdl",
    "compiler",
    "intermediate-representation",
    "semantic-validation"
  ],
  "license": "Apache-2.0",
  "homepage": "https://archstone.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NousVigil/archstone.git",
    "directory": "packages/compiler"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@archstone/schema": "workspace:*",
    "jsonpath-plus": "^10.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
