{
  "name": "@archstone/cli",
  "version": "0.27.0",
  "private": false,
  "type": "module",
  "description": "Archstone CLI — compile a business capability definition (CDL) into tools an AI agent can call: apply, build, serve over MCP, and verify against the live backend.",
  "mcpName": "io.github.NousVigil/archstone",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "archstone",
    "cdl",
    "cli",
    "compiler",
    "claude",
    "anthropic",
    "code-generation",
    "api-integration"
  ],
  "license": "Apache-2.0",
  "homepage": "https://archstone.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archstone-Romania/archstone.git",
    "directory": "packages/cli"
  },
  "main": "./dist/index.js",
  "bin": {
    "archstone": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@archstone/compiler": "workspace:*",
    "@archstone/emitter-support": "workspace:*",
    "@archstone/init": "workspace:*",
    "@archstone/provider-sql": "workspace:*",
    "@archstone/runtime": "workspace:*",
    "@archstone/schema": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
