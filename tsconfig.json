{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@archstone/schema": ["packages/schema/src/index.ts"],
      "@archstone/compiler": ["packages/compiler/src/index.ts"],
      "@archstone/emitter-support": ["packages/emitter-support/src/index.ts"],
      "@archstone/agent": ["packages/agent/src/index.ts"],
      "@archstone/init": ["packages/init/src/index.ts"],
      "@archstone/init/loop": ["packages/init/src/loop.ts"],
      "@archstone/runtime": ["packages/runtime/src/index.ts"],
      "@archstone/runtime/http": ["packages/runtime/src/http.ts"],
      "@archstone/runtime/verify": ["packages/runtime/src/verify.ts"],
      "@archstone/runtime/connector": ["packages/runtime/src/connector.ts"],
      "@archstone/runtime/connector-rest": ["packages/runtime/src/connector-rest.ts"],
      "@archstone/provider-rest": ["providers/rest/src/index.ts"],
      "@archstone/provider-sql": ["providers/sql/src/index.ts"]
    }
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "providers/**/src/**/*.ts",
    "examples/showcase/test/**/*.ts"
  ]
}
