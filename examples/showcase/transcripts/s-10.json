  "asserts": [
    {
      "claim": "`build` exits 0 and writes the IR the SDK loads",
      "negative": false
    },
    {
      "claim": "the booking is made (status ok)",
      "negative": false
    },
    {
      "claim": "a payment without an approval id is refused as input_invalid, and the agency is not asked",
      "negative": true
    },
    {
      "claim": "the agent requests an approval for exactly this payment, and it starts pending",
      "negative": false
    },
    {
      "claim": "paying while the approval is pending is refused approval_pending, and the agency is not asked to pay",
      "negative": true
    },
    {
      "claim": "the agent waits by reading the status, which says pending",
      "negative": false
    },
    {
      "claim": "a person at the agency approves it, outside Archstone (no capability decides)",
      "negative": false
    },
    {
      "claim": "the status now says approved",
      "negative": false
    },
    {
      "claim": "with the runtime's secret wrong, the agency's endpoint answers 401 and the call is policy_unevaluatable, not a refusal",
      "negative": true
    },
    {
      "claim": "with the approval granted, the payment goes through",
      "negative": false
    },
    {
      "claim": "its execution record carries the approval presented and the agency's decision reference",
      "negative": false
    },
    {
      "claim": "the same approval presented again is refused approval_refused: the agency used it up",
      "negative": true
    },
    {
      "claim": "the status says used",
      "negative": false
    },
    {
      "claim": "a cancellation a person rejected is refused approval_refused",
      "negative": true
    },
    {
      "claim": "an approval granted to cancel another booking cannot pay for this one: approval_refused",
      "negative": true
    },
    {
      "claim": "an agent is given an approval's id, status and expiry, and nothing else the agency returned (approver contact, requesting principal)",
      "negative": true
    },
