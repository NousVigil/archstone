# shipped product.
.claude/

# Dependencies & build output
node_modules/
dist/
build/
out/
*.tsbuildinfo
coverage/
.turbo/
.cache/

# Env & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
